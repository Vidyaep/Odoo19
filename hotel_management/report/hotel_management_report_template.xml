<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <template id="hotel_management_report_details">
       <t t-call="web.html_container">
          <t t-foreach="docs" t-as="o">
               <t t-call="web.external_layout">
                   <div class="page">
                       <div class="oe_structure"/><br></br>
                       <h2>Hotel Management Report</h2>
                       <br></br>
                       <p>
                           Date from :
                           <span t-field="o.date_from"/>
                       </p>
                       <p>
                           Date to :
                           <span t-field="o.date_to"/>
                       </p>
                       <p>
                           Guest Name :
                           <span t-field="o.guest_name"/>
                       </p>
                   </div>
                   <table class="table table-condensed" >
                                        <thead>
                                            <tr>
                                                <th>SL NO.</th>
                                                <th>GUEST</th>
                                                <th>CHECK IN</th>
                                                <th>CHECK OUT</th>
                                                <th>STATE</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="doc.all_lines" t-as="d">
                                                <tr style="border:solid grey 4px">
                                                    <td><span t-esc="d.sequence"/></td>
                                                    <td><span t-esc="d.guests"/></td>
                                                    <td><span t-esc="d.check_in"/></td>
                                                    <td><span t-esc="d.check_out"/></td>
                                                    <td><span t-esc="d.state"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                </table>
               </t>
           </t>
       </t>
   </template>
</odoo>
