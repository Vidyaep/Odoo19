<?xml version="1.0" encoding="utf-8" ?>
<odoo>
   <data>
       <record id="email_template_action" model="mail.template">
           <field name="name">Remainder Mail</field>
           <field name="model_id" ref="hotel_management.model_hotel_accommodation"/>
           <field name="subject"> "Checkout date is today {{ object.guests.name }}"</field>
           <field name="email_to">{{ object.guests.email}}</field>
           <field name="body_html" type="html">
               <div style="margin: 0px; padding: 0px;">
                   <p style="margin: 0px; padding: 0px; font-size: 13px;">
                       Hello<span style="font-weight: bold;" t-out="object.guests.name"/>,
                       <br/>
                       <br/>
                       This is an email to remind that checkout date is today
                   </p>
               </div>
           </field>
       </record>
   </data>
</odoo>