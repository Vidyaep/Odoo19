<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_internal_transfer">
           <field name="name">Internal Transfer</field>
           <field name="sequence">4</field>
       </record>
       <record model="res.groups.privilege" id="res_groups_privilege_transfer">
           <field name="name">Internal Transfer</field>
           <field name="category_id" ref="internal_transfer.module_category_internal_transfer"/>
       </record>

       <record id="group_transfer_user" model="res.groups">
           <field name="name">Normal User</field>
           <field name="privilege_id" ref="res_groups_privilege_transfer" />
           <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
       </record>

       <record id="group_transfer_admin" model="res.groups">
           <field name="name">Admin User</field>
           <field name="privilege_id" ref="res_groups_privilege_transfer" />
           <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
       </record>
    </data>
</odoo>