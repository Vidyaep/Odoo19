<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="action_lunch_add" model="ir.actions.server">
        <field name="name">Lunch Add</field>
        <field name="model_id" ref="hotel_management.model_hotel_item"/>
        <field name="state">code</field>
        <field name="code">model.action_lunch</field>
    </record>

    <record id="automated_action_lunch" model="base.automation">
        <field name="name">Add To Lunch</field>
        <field name="model_id" ref="hotel_management.model_hotel_item"/>
        <field name="trigger">on_create</field>
        <field name="action_server_ids" eval="[(4, ref('action_lunch_add'))]"/>
    </record>
</data>
</odoo>
