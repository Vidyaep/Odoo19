<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="employee_loan_line_action" model="ir.actions.act_window">
            <field name="name">Employee Loan Lines</field>
            <field name="res_model">employee.loan.line</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="employee_loan_line_list" model="ir.ui.view">
            <field name="name">Employee Loan Lines</field>
            <field name="model">employee.loan.line</field>
            <field name="arch" type="xml">
              <list>
                  <field name="loan_id"/>
                  <field name="date"/>
                  <field name="amount"/>
                  <field name="paid"/>
              </list>
            </field>
        </record>

        <record id="employee_loan_line_form" model="ir.ui.view">
            <field name="name">Employee Loan Lines</field>
            <field name="model">employee.loan.line</field>
            <field name="arch" type="xml">
              <form>
                  <group>
                    <field name="loan_id" widget="many2one"/>
                    <field name="date"/>
                    <field name="amount"/>
                    <field name="paid"/>
                  </group>
              </form>
            </field>
        </record>
    </data>
</odoo>