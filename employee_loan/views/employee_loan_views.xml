<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="employee_loan_action" model="ir.actions.act_window">
            <field name="name">Employee Loan</field>
            <field name="res_model">employee.loan</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="employee_loan_list" model="ir.ui.view">
            <field name="name">Employee Loan</field>
            <field name="model">employee.loan</field>
            <field name="arch" type="xml">
              <list>
                  <field name="name"/>
                  <field name="employee_id"/>
                  <field name="loan_amount"/>
                  <field name="start_date"/>
              </list>
            </field>
        </record>

        <record id="employee_loan_form" model="ir.ui.view">
            <field name="name">Employee Loan</field>
            <field name="model">employee.loan</field>
            <field name="arch" type="xml">
              <form>
                  <group>
                  <field name="name"/>
                  <field name="employee_id"/>
                  <field name="loan_amount"/>
                  <field name="start_date"/>
                  </group>
                  <notebook>
                      <page>
                          <field name="loan_line_ids"/>
                      </page>
                  </notebook>
              </form>
            </field>
        </record>

    </data>
</odoo>