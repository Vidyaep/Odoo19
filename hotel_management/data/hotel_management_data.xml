<odoo>
    <data noupdate="1">
        <record id="hotel_room_id1" model="hotel.room">
            <field name="room_no">5</field>
            <field name="bed">single</field>
            <field name="available_beds">2</field>
            <field name="rent">300</field>
            <field name="state">available</field>
        </record>

        <record id="hotel_room_id2" model="hotel.room">
            <field name="room_no">6</field>
            <field name="bed">double</field>
            <field name="available_beds">1</field>
            <field name="rent">800</field>
            <field name="state">available</field>
        </record>

        <record id="hotel_facility_id1" model="hotel.facility">
            <field name="name">fridge</field>
        </record>

        <record id="hotel_facility_id2" model="hotel.facility">
            <field name="name">mixer</field>
        </record>

        <record id="hotel_category_id1" model="hotel.category">
            <field name="name">Evening</field>
        </record>

        <record id="hotel_category_id2" model="hotel.category">
            <field name="name">Junk Food</field>
        </record>

        <record id="expense_hotel_id1" model="product.product">
            <field name="name">Restaurant Expenses</field>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
            <field name="type">service</field>
            <field name="categ_id" eval="ref('product.product_category_expenses', raise_if_not_found=False)"/>
        </record>

        <record id="expense_hotel_id2" model="product.product">
            <field name="name">Rent</field>
            <field name="list_price">0.0</field>
            <field name="standard_price">0.0</field>
            <field name="type">service</field>
            <field name="categ_id" eval="ref('product.product_category_expenses', raise_if_not_found=False)"/>
        </record>

    </data>
</odoo>