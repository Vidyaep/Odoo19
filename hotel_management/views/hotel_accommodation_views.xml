<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="hotel_accommodation" model="ir.actions.act_window">
          <field name="name">Accommodation</field>
          <field name="res_model">hotel.accommodation</field>
          <field name="context">{'search_default_filter_check_out': True, 'search_default_current': True}</field>
          <field name="view_mode">list,form</field>
       </record>

       <record id="search_view" model="ir.ui.view">
          <field name="name">Search View</field>
          <field name="model">hotel.accommodation</field>
          <field name="arch" type="xml">
            <search>
                <field name="room"/>
                <field name="guests"/>
                <field name="sequence"/>
                <filter string="Archived" name="unarchive" domain="[('active','=',False)]"/>
                <filter string="Expected Checkouts" name="filter_check_out" domain="[('status','in','check-in'),('expected_date','=',current_date)]"/>
                <filter string="Next Day Expected Checkouts" name="filter_check_outs" domain="[('status','in','check-in'),('expected_date','=',(context_today() + datetime.timedelta(days=1)))]"/>
                <filter string="Room" name="group_by_room" context="{'group_by': 'room'}"/>
                <filter string="Bed Type" name="group_by_bed_type" context="{'group_by': 'bed_type'}"/>
                <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                <filter string="Check-in" name="filter_check_in" domain="[('status','=','check-in')]"/>
                <filter string="Cancel" name="filter_cancel" domain="[('status','=','cancel')]"/>
                <filter string="Exclude Cancelled" name="filter_accommodation" domain="[('status','!=','cancel')]"/>
            </search>
          </field>
       </record>

       <record id="hotel_accommodation_list" model="ir.ui.view">
          <field name="name">Accommodation</field>
          <field name="model">hotel.accommodation</field>
          <field name="arch" type="xml">
               <list decoration-danger="status in 'check-in' and expected_date == current_date"
                     decoration-warning="status not in 'check-out' and expected_date == current_date">
                   <field name="sequence"/>
                   <field name="guests"/>
                   <field name="guest_address"/>
                   <field name="guest_count"/>
                   <field name="check_in"/>
                   <field name="check_out"/>
                   <field name="bed_type"/>
                   <field name="facility"/>
                   <field name="room"/>
                   <field name="status"/>
                   <field name="id_proof"/>
                   <field name="active"/>
               </list>
           </field>
       </record>
        <record id="hotel_accommodation_form" model="ir.ui.view">
          <field name="name">Accommodation</field>
          <field name="model">hotel.accommodation</field>
          <field name="arch" type="xml">
               <form>
                   <header>
                       <button name="checkin" type="object" class="oe_highlight" string="Check In" invisible="status not in ['draft']"></button>
                       <button name="checkout" type="object" class="oe_highlight" string="Check Out" invisible="status not in ['draft','check-in']"></button>
                       <button name="cancel" type="object" string="Cancel" invisible="status in ['cancel']"></button>
                        <field name="status" widget="statusbar" statusbar_visible="draft,check-in,check-out,cancel"/>
                   </header>
                   <sheet>
                       <div name="button_box" position="inside">
                         <button class="oe_stat_button" type="object" icon="fa-list" name="action_get_orders">
                         <field string="Orders" name="order_count" widget="statinfo"/>
                         </button>
                         <button class="oe_stat_button" type="object" icon="fa-edit" name="action_view_invoices">
                         <field string="Invoices" name="invoice_count" widget="statinfo"/>
                         </button>
                       </div>
                       <field name="payment_state" invisible="1"/>
                       <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="payment_state not in ['paid']"/>
                       <h1><field name="sequence"/></h1>
                    <group>
                        <group>
                        <field name="guests" widget="res_partner_many2one" context="{'show_address': 1, 'show_vat': True}" options="{'always_reload': True}"/>
                        <field name="guest_count"/>
                        <field name="expected_days" invisible="status not in ['draft','check-in']"/>
                        <field name="expected_date" invisible="status not in ['draft','check-in']"/>
                        </group>
                    <group>
                      <field name="check_in"/>
                      <field name="check_out"/>
                      <field name="bed_type"/>
                      <field name="facility" widget="many2many_tags" options="{'no_create':true}"/>
                      <field name="room" widget="many2many_tags" options="{'no_create':true}" domain="[('facility','in',facility),('state','=','available'),('bed','in',bed_type)]"/>
                      <field name="status"/>
                      <field name="id_proof"/>
                        <field name="active"/>
                    </group>
                       </group>
                       <notebook>
                           <page string="Guests">
                               <field name="guest_ids">
                               <list editable="bottom">
                               <field name="name"/>
                               <field name="gender"/>
                               <field name="age"/>
                               </list>
                               </field>
                           </page>
                           <page string="Payment">
                             <field name="payment_line_ids" readonly="1">
                               <list create="false" edit="false" delete="false">
                                      <field name="name"/>
                                      <field name="quantity"/>
                                      <field name="price"/>
                               </list>
                             </field>
                             <group>
                                 <field name="total_all" string="Total"/>
                             </group>
                           </page>
                       </notebook>
                   </sheet>
                   <chatter/>
               </form>
           </field>
       </record>
    </data>
</odoo>