<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <record id="hotel_order_view_form" model="ir.ui.view">
       <field name="name">Order Food</field>
       <field name="model">hotel.kanban</field>
       <field name="arch" type="xml">
           <form>
               <group>
                   <field name="item_name"/>
                   <field name="item_quantity"/>
                   <field name="price"/>
                   <field name="description"/>
               </group>
               <footer>
               <button name="add_list" string="Add to list" type="object"></button>
                   <button string="Cancel" type="object"></button>
               </footer>
           </form>
       </field>
   </record>
   <record id="action_order_kanban" model="ir.actions.act_window">
       <field name="name">Order Wizard</field>
       <field name="res_model">hotel.kanban</field>
       <field name="view_mode">kanban,list,form</field>
   </record>
</odoo>
