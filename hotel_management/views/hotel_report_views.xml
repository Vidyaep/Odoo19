<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <record id="hotel_report_view_form" model="ir.ui.view">
       <field name="name">Hotel Management Report</field>
       <field name="model">hotel.report</field>
       <field name="arch" type="xml">
           <form>
               <group>
                   <field name="date_from"/>
                   <field name="date_to"/>
                   <field name="guest_name"/>
               </group>
               <footer>
               <button name="generate" string="Generate" class="oe_highlight" type="object"></button>
               <button string="Cancel" type="object"></button>
               </footer>
           </form>
       </field>
   </record>
   <record id="action_hotel_report" model="ir.actions.act_window">
       <field name="name">Hotel Management Report</field>
       <field name="res_model">hotel.report</field>
       <field name="view_mode">form</field>
       <field name="target">new</field>
   </record>
</odoo>
