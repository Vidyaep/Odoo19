<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <template id="hotel_management_report_details">
       <t t-call="web.html_container">
          <t t-foreach="docs" t-as="o">
               <t t-call="web.external_layout">
                   <div class="page">
                       <div class="oe_structure"/><br></br>
                       <h2>Hotel Management Report</h2>
                       <br></br>
                       <p>
                           Date from :
                           <span t-field="o.date_from"/>
                       </p>
                       <p>
                           Date to :
                           <span t-field="o.date_to"/>
                       </p>
                       <p>
                           Guest Name :
                           <span t-field="o.guest_name"/>
                       </p>
                   </div>
                   <table class="table table-condensed" >
                                        <thead>
                                            <tr>
                                                <th><b>SL NO.</b></th>
                                                <th><b>GUEST</b></th>
                                                <th><b>CHECK IN</b></th>
                                                <th><b>CHECK OUT</b></th>
                                                <th><b>STATE</b></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                                <t t-set="results" t-value="o.generate()"/>
                                                  <t t-foreach="results" t-as="d">
                                                    <tr style="border-bottom: 1px solid grey;">
                                                      <td><span t-esc="d.get('sequence', 'NA')"/></td>
                                                      <td><span t-esc="d.get('name', 'NA')"/></td>
                                                      <td><span t-esc="d.get('check_in')"/></td>
                                                      <td><span t-esc="d.get('check_out')"/></td>
                                                      <td><span t-esc="d.get('status', 'Unknown')"/></td>
                                                    </tr>
                                                  </t>
                                        </tbody>
                                </table>
               </t>
           </t>
       </t>
   </template>
</odoo>
