<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="hotel_room" model="ir.actions.act_window">
            <field name="name">Rooms</field>
            <field name="res_model">hotel.room</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="hotel_room_list" model="ir.ui.view">
        <field name="name">Rooms</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list>
            <field name="room_no"/>
            <field name="bed"/>
            <field name="available_beds"/>
            <field name="rent"/>
            <field name="facility"/>
            <field name="state"/>
            </list>
        </field>
        </record>

        <record id="hotel_room_form" model="ir.ui.view">
        <field name="name">Rooms</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="available,not_available"/>
                </header>
                <sheet>
                    <group>
                        <field name="room_no"/>
                        <field name="bed"/>
                        <field name="available_beds"/>
                    </group>
                    <group>
                        <field name="rent"/>
                        <field name="facility" widget="many2many_tags"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>