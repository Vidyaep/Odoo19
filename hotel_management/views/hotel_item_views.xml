<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
       <record id="hotel_item" model="ir.actions.act_window">
           <field name="name">Food Items</field>
           <field name="res_model">hotel.item</field>
           <field name="view_mode">list,form</field>
       </record>
       <record id="hotel_item_list" model="ir.ui.view">
          <field name="name">Food Items</field>
          <field name="model">hotel.item</field>
          <field name="arch" type="xml">
              <list>
                  <field name="image"/>
                  <field name="item_name"/>
                  <field name="category"/>
                  <field name="price"/>
                  <field name="quantity"/>
                  <field name="description"/>
              </list>
          </field>
       </record>

        <record id="hotel_item_form" model="ir.ui.view">
        <field name="name">Food Items</field>
        <field name="model">hotel.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <field name="item_name"/>
                        <field name="category" widget="many2one_tags"/>
                    </group>
                    <group>
                    <group>
                        <field name="price"/>
                        <field name="quantity"/>
                        <field name="description"/>
                    </group>
                    </group>
                </sheet>
            </form>
        </field>
        </record>
    </data>
</odoo>